{
  "entities": {
    "users": {
      "path": "users/{userId}",
      "fields": {
        "userId": { "type": "string" },
        "displayName": { "type": "string" },
        "createdAt": { "type": "timestamp" },
        "updatedAt": { "type": "timestamp" }
      }
    },
    "conversations": {
      "path": "users/{userId}/conversations/{messageId}",
      "fields": {
        "id": { "type": "string" },
        "role": { "type": "string" },
        "content": { "type": "string" },
        "intent": { "type": "string", "optional": true },
        "actionUrl": { "type": "string", "optional": true },
        "actionLabel": { "type": "string", "optional": true },
        "timestamp": { "type": "timestamp" }
      }
    },
    "notes": {
      "path": "users/{userId}/notes/{noteId}",
      "fields": {
        "id": { "type": "string" },
        "content": { "type": "string" },
        "createdAt": { "type": "timestamp" },
        "updatedAt": { "type": "timestamp" }
      }
    }
  }
}
